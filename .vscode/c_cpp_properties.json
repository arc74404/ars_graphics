{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**",
                "C:/vcpkg/installed/x64-windows/include"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "windowsSdkVersion": "10.0.26100.0",
            "compilerPath": "cl.exe",
            "intelliSenseMode": "windows-msvc-x64",
            "cppStandard": "c++23",
            "compilerArgs": [
                "/Zc:__cplusplus" // включает правильное значение __cplusplus
            ]
        }
    ],
    "version": 4
}